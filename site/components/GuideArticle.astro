---
import Toc from "./Toc.astro";
import { SOURCES_NOTE, guides, readingMinutes, guidePath, topicById } from "@/lib/academy.mjs";

interface GuideLink {
  slug: string;
  title: string;
  topic: string;
}

interface Section {
  id: string;
  heading: string;
  paragraphs: string[];
}

interface Source {
  title: string;
  detail: string;
}

interface Guide {
  slug: string;
  title: string;
  dek: string;
  topic: string;
  definition: string[];
  takeaways: string[];
  sections: Section[];
  related: string[];
  sources: Source[];
}

interface Props {
  guide: Guide;
}

const { guide } = Astro.props;
const topic = topicById(guide.topic);
const minutes = readingMinutes(guide);
const related = guide.related.map((slug) => {
  const hit = guides.find((item) => item.slug === slug) as GuideLink | undefined;
  if (!hit) throw new Error(`Missing related guide ${slug}`);
  return hit;
});
const toc = [
  { id: "definition", label: "Definition" },
  { id: "takeaways", label: "Key takeaways" },
  ...guide.sections.map((section) => ({ id: section.id, label: section.heading })),
  { id: "related", label: "Related guides" },
  { id: "sources", label: "Sources" },
];
---

<article class="academy-guide">
  <nav class="report-crumb" aria-label="Breadcrumb">
    <a href="/">Academy</a>
    <span aria-hidden="true"> / </span>
    <a href="/guides">Guides</a>
    <span aria-hidden="true"> / </span>
    <a href={`/guides#${topic?.id}`}>{topic?.title}</a>
  </nav>
  <div class="academy-guide__grid">
    <div class="academy-guide__toc">
      <Toc items={toc} label="In this guide" />
    </div>
    <header class="report-head academy-guide__head">
      <p class="report-kicker">Guide</p>
      <h1>{guide.title}</h1>
      <p class="report-dek">{guide.dek}</p>
      <p class="report-byline">
        Artometrics Academy · {topic?.title} · {minutes} min read · neutral guide
      </p>
    </header>
    <div class="academy-guide__body">
      <section class="guide-def" id="definition" aria-labelledby="definition-title">
        <h2 class="academy-label" id="definition-title">Definition</h2>
        {guide.definition.map((paragraph) => <p set:html={paragraph} />)}
      </section>
      <section class="guide-takeaways" id="takeaways" aria-labelledby="takeaways-title">
        <h2 class="academy-label" id="takeaways-title">Key takeaways</h2>
        <ul>
          {guide.takeaways.map((item) => <li set:html={item} />)}
        </ul>
      </section>
      <div class="report-body">
        {
          guide.sections.map((section) => (
            <section aria-labelledby={section.id}>
              <h2 id={section.id}>{section.heading}</h2>
              {section.paragraphs.map((paragraph) => <p set:html={paragraph} />)}
            </section>
          ))
        }
      </div>
      <section class="report-related" id="related" aria-labelledby="related-title">
        <h2 id="related-title">Related guides</h2>
        {
          related.map((item) => (
            <a href={guidePath(item.slug)}>
              <span class="academy-label">{topicById(item.topic)?.title}</span>
              {item.title}
            </a>
          ))
        }
      </section>
      <section class="academy-sources" id="sources" aria-labelledby="sources-title">
        <h2 id="sources-title">Sources & further reading</h2>
        <p class="academy-sources__note">{SOURCES_NOTE}</p>
        <ul>
          {
            guide.sources.map((source) => (
              <li>
                {source.title} <span>{source.detail}</span>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>
</article>
