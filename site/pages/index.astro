---
import Base from "../layouts/Base.astro";
import { essays, guides, questions, topics, guidePath, journeyPath, topicById } from "@/lib/academy.mjs";

const featuredSlugs = [
  "art-science-intersection",
  "what-is-an-art-scientist",
  "how-to-look-at-a-painting",
  "color-theory-physically",
  "golden-ratio",
];
const featuredQuestions = questions.filter((item) => item.featured);
const featured = featuredSlugs.map((slug) => {
  const guide = guides.find((item) => item.slug === slug);
  if (!guide) throw new Error(`Missing featured guide ${slug}`);
  return guide;
});
---

<Base
  title="Artometrics Academy"
  description="Learn the art–science intersection. Here are the things I've found, so you can get farther than I did."
  path="/"
>
  <div class="wrap academy-page">
    <header class="home-hero">
      <p class="product-kicker">Academy</p>
      <h1>Learn the intersection.</h1>
      <p class="lede">
        Learn the art–science intersection. Here are the things I've found, so you can get farther than I did.
      </p>
      <p class="academy-note">
        The guides are neutral: a definition, a mechanism, and the limit of both.
        <a href="/journey">The Journey</a> is the personal strand, written in the first person and kept separate so an opinion never pretends to be a definition.
      </p>
    </header>

    <div class="section-head">
      <h2>Categories</h2>
      <a href="/guides">All guides</a>
    </div>
    <div class="card-grid">
      {
        topics.map((topic) => {
          const count = guides.filter((guide) => guide.topic === topic.id).length;
          return (
            <a class="teaser" href={`/guides#${topic.id}`}>
              <span class="teaser__kind">{count === 1 ? "1 guide" : `${count} guides`}</span>
              <h2>{topic.title}</h2>
              <p>{topic.dek}</p>
            </a>
          );
        })
      }
    </div>

    <div class="section-head">
      <h2>Featured guides</h2>
      <a href="/guides#alphabetical">Browse A–Z</a>
    </div>
    <div class="card-grid">
      {
        featured.map((guide) => (
          <a class="teaser" href={guidePath(guide.slug)}>
            <span class="teaser__kind">{topicById(guide.topic)?.title}</span>
            <h2>{guide.title}</h2>
            <p>{guide.dek}</p>
          </a>
        ))
      }
    </div>

    <div class="section-head">
      <h2>Common questions</h2>
      <a href="/questions">All questions</a>
    </div>
    <p class="academy-note">
      The beginner questions, in the same voice as the guides. Each answer stops at the page that carries the mechanism.
    </p>
    <div class="card-grid">
      {
        featuredQuestions.map((item) => (
          <a class="teaser" href={`/questions#${item.id}`}>
            <span class="teaser__kind">Question</span>
            <h2>{item.question}</h2>
            <p>{item.dek}</p>
          </a>
        ))
      }
    </div>

    <div class="section-head">
      <h2>The Journey</h2>
      <a href="/journey">All notes</a>
    </div>
    <p class="academy-note">
      What I've learned, where I was wrong, and where art and science actually meet for me. These are opinions. The guides are the check.
    </p>
    <div class="card-grid">
      {
        essays.map((essay) => (
          <a class="teaser" href={journeyPath(essay.slug)}>
            <span class="teaser__kind">The Journey</span>
            <h2>{essay.title}</h2>
            <p>{essay.dek}</p>
          </a>
        ))
      }
    </div>
  </div>
</Base>
