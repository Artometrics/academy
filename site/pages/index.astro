---
import Base from "../layouts/Base.astro";
---

<Base
  title="Artometrics Academy"
  description="Beginner guides at the intersection of art and science — the things we've found, so you can get farther than we did."
  path="/"
>
  <div class="wrap">
    <header class="home-hero">
      <p class="product-kicker">Academy</p>
      <h1>Learn the intersection.</h1>
      <p class="lede">
        Artometrics Academy is a set of beginner guides for people who want to be art scientists
        — or science artists — and cannot spend a lifetime reading all of either field. These are
        the ideas, methods, and journeys we'd hand you first.
      </p>
    </header>

    <div class="section-head">
      <h2>Guides</h2>
      <p>Investopedia-style starters</p>
    </div>
    <div class="card-grid">
      <a class="teaser" href="/guides/what-is-artometrics">
        <span class="teaser__kind">Guide</span>
        <h2>What is Artometrics?</h2>
        <p>A short definition of the practice, what it is not, and how to start reading the world as both art and data.</p>
      </a>
      <div class="teaser teaser--placeholder">
        <span class="teaser__kind">Coming next</span>
        <h2>Where art and science meet</h2>
        <p>Placeholder for a guide on shared methods — observation, experiment, iteration, and form.</p>
      </div>
      <div class="teaser teaser--placeholder">
        <span class="teaser__kind">Coming next</span>
        <h2>A journey in art</h2>
        <p>Placeholder for a first-person path: what was learned, what was wrong, and what to skip.</p>
      </div>
    </div>
  </div>
</Base>
